# Frontend (Vite) — copy to `.env` in the project root for local development.
# Do not commit real values.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:8787

# Backend Worker secrets are not read from this file.
# For local Wrangler, copy api/.dev.vars.example to api/.dev.vars.
# For production, set them with `wrangler secret put` (see api/README.md).
#
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   STRIPE_MONTHLY_PRICE_ID
#   STRIPE_ANNUAL_PRICE_ID
#   STRIPE_MONTHLY_PAYMENT_LINK_ID
#   STRIPE_ANNUAL_PAYMENT_LINK_ID
#   SENDGRID_API_KEY
#   SENDGRID_FROM_EMAIL
#   SENDGRID_REPLY_TO_EMAIL
#   XAI_API_KEY
